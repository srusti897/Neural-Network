      "source": [
        "import numpy as np\n",
        "# Create two (2, 3) tensors with random integer values\n",
        "A = np.random.randint(0, 10, size=(2, 3))\n",
        "B = np.random.randint(0, 10, size=(2, 3))\n",
        "# Element-wise addition\n",
        "C = A + B\n",
        "print(\"A:\\n\", A)\n",
        "print(\"\\nB:\\n\", B)\n",
        "print(\"\\nElement-wise Addition (A + B):\\n\", C)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import tensorflow as tf\n",
        "# Create two random integer tensors of shape (2, 3)\n",
        "A = tf.random.uniform((2, 3), minval=0, maxval=10, dtype=tf.int32)\n",
        "B = tf.random.uniform((2, 3), minval=0, maxval=10, dtype=tf.int32)\n",
        "# Element-wise addition\n",
        "C = tf.add(A, B)\n",
        "print(\"Tensor A:\\n\", A)\n",
        "print(\"Tensor B:\\n\", B)\n",
        "print(\"A + B:\\n\", C)"
      ],
